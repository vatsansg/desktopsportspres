# Copy to `.env` (git-ignored) and fill in locally. NEVER commit `.env`.
# The Storage Account access key is only needed from Phase 4 - leave blank until then.

# Optional: override where the SQLite DB, logs and downloaded assets live.
# Default: %LOCALAPPDATA%\LEDAssetSync
# LEDSYNC_DATA_DIR=

# --- Phase 4 onward ---
# STORAGE_ACCOUNT_NAME=sasportspresentation
# STORAGE_ACCOUNT_KEY=
