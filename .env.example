# Copy to `.env` (git-ignored) - or better, run scripts\set_storage_key.ps1, which prompts for the key
# with hidden input and writes .env for you. NEVER commit `.env`.
#
# DEVELOPMENT ONLY: an installed build never reads a .env. On a venue machine the Storage Account key
# is entered in Settings > Cloud Storage.

# Optional: override where the SQLite DB, logs and downloaded assets live.
# Default: %LOCALAPPDATA%\LEDAssetSync
# LEDSYNC_DATA_DIR=

# Cloud Storage (used only for fields not saved in Settings)
# STORAGE_ACCOUNT_NAME=sasportspresentation
# STORAGE_CONTAINER=2026
# STORAGE_ACCOUNT_KEY=
